# Copy to .env and adjust if any of these default host ports are already
# taken by something else on your machine. docker-compose.yml reads these
# automatically; nothing here affects inter-service traffic (that uses the
# compose network's own hostnames/ports regardless of these overrides).

POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025
API_PORT=8080

# send_email delivery. Left unset, the worker relays through the local
# Mailpit sink above -- mail never leaves the compose network, view it at
# http://localhost:8025. To have send_email jobs deliver to a real inbox,
# uncomment and fill these in with a real provider's SMTP relay + your
# credentials for it (never commit real values here -- this file is the
# template; your actual values belong in your own untracked .env).
#
# Brevo (https://www.brevo.com) is a good default choice: free forever,
# 300 emails/day, no credit card, and a plain SMTP relay that needs no code
# changes here -- sign up, then Settings -> SMTP & API -> SMTP tab for your
# login + a generated SMTP key (not your account password).
#   SMTP_ADDR=smtp-relay.brevo.com:587
#   SMTP_FROM=you@yourdomain.com
#   SMTP_USERNAME=your-brevo-login-email
#   SMTP_PASSWORD=your-brevo-smtp-key
#
# Any other STARTTLS-on-587 provider works the same way, e.g. Gmail
# (smtp.gmail.com:587, an account App Password, From must equal that Gmail
# address) or SendGrid (smtp.sendgrid.net:587, username literally "apikey").
# SMTP_ADDR=
# SMTP_FROM=
# SMTP_USERNAME=
# SMTP_PASSWORD=
